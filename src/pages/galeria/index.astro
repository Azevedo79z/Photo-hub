---
import "../../styles/global.css";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070b13" />
    <meta name="description" content="Galeria de fotografias Josy — PHOTO HUB." />
    <title>Galeria Josy — PHOTO HUB</title>
    <style>
      .gallery-shell{width:min(1180px,calc(100% - 40px));margin:0 auto}
      .gallery-head{padding:76px 0 34px}
      .gallery-head h1{font-size:clamp(2.5rem,6vw,5rem);line-height:1.02;letter-spacing:-.055em;margin:18px 0}
      .gallery-head h1 span{color:#54b9ff}
      .gallery-head p{color:#9baabd;max-width:620px;line-height:1.7}
      .gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding-bottom:70px}
      .photo{display:block;position:relative;overflow:hidden;border:1px solid #26364a;border-radius:18px;background:#101a29;min-height:220px;aspect-ratio:4/5;text-decoration:none}
      .photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}
      .photo:hover img{transform:scale(1.045)}
      .photo:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(4,9,18,.92))}
      .photo-meta{position:absolute;z-index:1;left:16px;right:16px;bottom:15px;display:flex;flex-direction:column;gap:5px;color:white}
      .photo-meta b{font-size:.7rem;letter-spacing:.16em;color:#71c8ff}
      .photo-meta small{font-size:.72rem;opacity:.8;overflow-wrap:anywhere}
      .gallery-note{color:#91a2b8;font-size:.85rem;padding:0 0 34px}
      @media(max-width:760px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.gallery-shell{width:min(100% - 24px,1180px)}.photo{border-radius:12px;min-height:180px}.photo-meta{left:10px;right:10px;bottom:10px}.photo-meta small{font-size:.62rem}}
      @media(max-width:420px){.gallery-grid{grid-template-columns:1fr 1fr}.photo{aspect-ratio:3/4}}
    </style>
  </head>
  <body>
    <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div>
    <header class="topbar shell">
      <a class="brand" href="/" aria-label="Photo Hub início"><span class="brand-mark">P<span>H</span></span><span class="brand-name">PHOTO<span>HUB</span><small>INTELLIGENT PHOTOGRAPHY</small></span></a>
      <nav aria-label="Navegação principal"><a class="nav-link" href="/">Início</a><a class="nav-link active" href="/galeria">Galeria</a></nav>
      <a class="access-link" href="/">Voltar ao início <span>↗</span></a>
    </header>
